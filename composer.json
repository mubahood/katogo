{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "berkayk/onesignal-laravel": "^2.4",
        "darkaonline/l5-swagger": "^8.6",
        "encore/laravel-admin": "^1.8",
        "guzzlehttp/guzzle": "^7.9",
        "jxlwqq/quill": "^1.0",
        "kreait/firebase-php": "^7.10",
        "laravel-admin-ext/chartjs": "^1.0",
        "laravel-admin-ext/grid-lightbox": "^1.0",
        "laravel-admin-ext/media-player": "^1.1",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "predis/predis": "^3.5",
        "spatie/laravel-health": "^1.34",
        "spatie/laravel-query-builder": "^5.8",
        "spatie/laravel-responsecache": "^7.5",
        "tymon/jwt-auth": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "laravel/tinker": "^2.8",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "rap2hpoutre/laravel-log-viewer": "^2.5",
        "spatie/laravel-ignition": "^2.0",
        "beyondcode/laravel-query-detector": "^1.6",
        "barryvdh/laravel-debugbar": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "swagger:routes": [
            "@php artisan route:list --path=api --json > storage/api-docs/route-inventory.json"
        ],
        "swagger:annotate": [
            "@php scripts/generate_swagger_annotations.php",
            "@php scripts/build_swagger_inventory.php"
        ],
        "swagger:generate": [
            "@composer swagger:routes",
            "@composer swagger:annotate",
            "@php artisan l5-swagger:generate"
        ],
        "swagger:postman": [
            "@composer swagger:generate",
            "openapi2postmanv2 -s storage/api-docs/api-docs.json -o storage/api-docs/katogo-postman-collection.json -p -O folderStrategy=Tags,requestParametersResolution=Example,optimizeConversion=false"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
